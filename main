const DEF={base:2,step:0.5,cap:100,data:15,review:20,cont:10,fw:80,rate:60,team:4,var:25};
const SZ={S:5,M:9,L:14};
const RC={'Automate – Wave 1':'w1','Automate – Wave 2':'w2','Keep manual':'man','Exclude – duplicate':'dup'};
let P={...DEF},UP=D.drivers.map(d=>d.uplift),MF={...D.modfactor};
let sortK='sc',sortDir=-1,shown=100,mode='topn',sel=new Set();
const $=id=>document.getElementById(id);
const fmt=(n,d=0)=>n.toLocaleString(undefined,{maximumFractionDigits:d,minimumFractionDigits:d});
const money=n=>'$'+fmt(Math.round(n));
const modOrder=Object.keys(MF).sort((a,b)=>D.rows.filter(r=>r.m===b).length-D.rows.filter(r=>r.m===a).length);
const eligible=D.rows.filter(r=>r.st!=='Duplicate');
const byScore=[...eligible].sort((a,b)=>b.sc-a.sc||a.n-b.n);
function save(){try{localStorage.setItem('nexgen-sel',JSON.stringify({mode,n:$('topn').value,sel:[...sel]}))}catch(e){}}
function calc(){
  const oh=1+(P.data+P.review+P.cont)/100;
  return D.rows.map(r=>{
    const up=Math.min(P.cap/100,r.f.reduce((a,f,i)=>a+(f?UP[i]:0),0));
    const mf=MF[r.m]??1;
    const raw=(P.base+r.s*P.step)*mf*(1+up);
    const script0=Math.ceil(raw*2-1e-9)/2;
    const factor=r.st==='Duplicate'?0:r.st==='Data variant'?P.var/100:1;
    const script=script0*factor,total=script*oh;
    const size=script0<=SZ.S?'S':script0<=SZ.M?'M':script0<=SZ.L?'L':'XL';
    return {...r,up,mf,script,total,cost:total*P.rate,size,factor,on:sel.has(r.n)};
  });
}
function applyMode(){
  if(mode==='topn'){const n=Math.max(1,Math.min(eligible.length,+$('topn').value||0));$('topn').value=n;sel=new Set(byScore.slice(0,n).map(r=>r.n));}
  else if(mode==='rec'){sel=new Set(eligible.filter(r=>r.rec.startsWith('Automate')).map(r=>r.n));}
  $('topn').disabled=mode!=='topn';save();
}
function render(){
  const rows=calc(),S=rows.filter(r=>r.on);
  const script=S.reduce((a,r)=>a+r.script,0),sub=S.reduce((a,r)=>a+r.total,0);
  const fw=S.length?P.fw:0,grand=sub+fw,pm=grand/6.5/21;
  $('k_total').textContent=fmt(grand,0)+' h';
  $('k_total_sub').textContent=`${S.length} selected case${S.length===1?'':'s'}: ${fmt(sub,0)} h + ${fmt(fw,0)} h framework`;
  $('k_cost').textContent=money(grand*P.rate); $('k_cost_sub').textContent=`at $${P.rate}/h blended`;
  $('k_pm').textContent=fmt(pm,1);
  $('k_dur').textContent=fmt(pm/P.team,1)+' mo'; $('k_dur_sub').textContent=`with ${P.team} engineer${P.team>1?'s':''} in parallel`;
  $('k_avg').textContent=(S.length?fmt(sub/S.length,1):'–')+' h';
  const all=D.rows,cnt=k=>all.filter(r=>r.rec===k).length;
  $('funnel').innerHTML=`<div>In file<b>${all.length}</b></div><div>Duplicates<b>${all.filter(r=>r.st==='Duplicate').length}</b></div><div>Data variants<b>${all.filter(r=>r.st==='Data variant').length}</b></div><div>Distinct scenarios<b>${eligible.length}</b></div><div>Recommended W1<b>${cnt('Automate – Wave 1')}</b></div><div>Recommended W2<b>${cnt('Automate – Wave 2')}</b></div><div style="border-color:var(--accent)">Selected<b style="color:var(--accent-text)">${S.length}</b></div>`;
  const agg={};S.forEach(r=>{(agg[r.m]??={h:0,c:0}).h+=r.total;agg[r.m].c++});
  const mods=Object.keys(agg).sort((a,b)=>agg[b].h-agg[a].h),max=mods.length?agg[mods[0]].h:1;
  $('bars').innerHTML=mods.map(m=>`<div class="bar"><span class="name" data-m="${m}" title="${m}">${m}</span><div class="track"><div class="fill" style="width:${agg[m].h/max*100}%"></div></div><span class="num mono">${fmt(agg[m].h,0)} h</span><span class="cnt mono">${agg[m].c} TC</span></div>`).join('')||'<div class="sub">Nothing selected.</div>';
  const parts=[['Scripting',script],['Test data prep',script*P.data/100],['Review & stabilisation',script*P.review/100],['Contingency',script*P.cont/100],['Framework setup',fw]];
  $('breakdown').innerHTML=parts.map(([k,v])=>`<div class="brow"><span>${k}</span><span class="mono">${fmt(v,0)} h<span class="pct">${grand?fmt(v/grand*100,0):0}%</span></span></div>`).join('')+`<div class="brow"><span>Total</span><span class="mono">${fmt(grand,0)} h</span></div>`;
  const sc={S:0,M:0,L:0,XL:0};S.forEach(r=>sc[r.size]++);const col={S:'var(--s)',M:'var(--m)',L:'var(--l)',XL:'var(--xl)'};
  $('stack').innerHTML=S.length?Object.keys(sc).map(s=>`<div style="width:${sc[s]/S.length*100}%;background:${col[s]}" title="${s}: ${sc[s]}">${sc[s]||''}</div>`).join(''):'';
  renderTable(rows);
}
function filtered(rows){
  const q=$('q').value.trim().toLowerCase(),m=$('fmod').value,rc=$('frec').value,s=$('fsize').value,dv=$('fdrv').value,dx=$('fdrvx').value,fs=$('fsel').value;
  let out=rows.filter(r=>(!q||r.t.toLowerCase().includes(q)||r.tc.toLowerCase().includes(q)||r.pbi.toLowerCase().includes(q))&&(!m||r.m===m)&&(!rc||r.rec===rc)&&(!s||r.size===s)&&(dv===''||r.f[+dv])&&(dx===''||!r.f[+dx])&&(fs===''||(fs==='1')===r.on));
  out.sort((a,b)=>{const x=a[sortK],y=b[sortK];return (typeof x==='number'?x-y:String(x).localeCompare(String(y)))*sortDir||a.n-b.n});
  return out;
}
let lastShown=[];
function renderTable(rows){
  const out=filtered(rows);lastShown=out;
  $('count').textContent=`${out.length} shown · ${rows.filter(r=>r.on).length} selected of ${eligible.length} eligible`;
  $('tbody').innerHTML=out.slice(0,shown).map(r=>`<tr class="${r.st==='Duplicate'?'dupe':r.on?'':'off'}"><td class="chk"><input type="checkbox" data-n="${r.n}" ${r.on?'checked':''} ${r.st==='Duplicate'?'disabled':''} aria-label="Select ${r.tc}"></td><td class="num mono">${r.n}</td><td><span class="rec ${RC[r.rec]}">${r.rec}</span>${r.st!=='Unique'?`<div><span class="st ${r.st==='Duplicate'?'dup':'var'}">${r.st}${r.canon?` → #${r.canon}`:''}</span></div>`:''}</td><td class="num"><span class="sc">${r.sc}</span></td><td class="mono">${r.tc}</td><td class="title">${r.t}${r.pbi?`<div class="pbi mono">${r.pbi}</div>`:''}<div class="why">${r.why}</div></td><td>${r.m}</td><td class="num mono">${r.s}</td><td>${r.f.map((f,i)=>f?`<span class="chip">${D.drivers[i].name}</span>`:'').join('')||'<span class="chip" style="opacity:.5">none</span>'}</td><td class="num mono">${Math.round(r.up*100)}%</td><td class="num mono">${r.script.toFixed(1)}</td><td><span class="size ${r.size}">${r.size}</span></td><td class="num mono">${r.total.toFixed(1)}</td><td class="num mono">${money(r.cost)}</td></tr>`).join('');
  const Ssel=out.filter(r=>r.on),T=k=>Ssel.reduce((a,r)=>a+r[k],0);
  $('tfoot').innerHTML=`<td colspan="7">Selected in view: ${Ssel.length} case${Ssel.length===1?'':'s'}</td><td class="num mono">${fmt(T('s'))}</td><td></td><td></td><td class="num mono">${fmt(T('script'),1)}</td><td></td><td class="num mono">${fmt(T('total'),1)}</td><td class="num mono">${money(T('cost'))}</td>`;
  const more=$('more');more.hidden=out.length<=shown;more.textContent=`Show ${Math.min(100,out.length-shown)} more (${out.length-shown} remaining)`;
  $('chkall').checked=out.length>0&&out.every(r=>r.on||r.st==='Duplicate');
  document.querySelectorAll('th[data-k]').forEach(th=>{th.classList.toggle('on',th.dataset.k===sortK);th.textContent=th.textContent.replace(/ [▲▼]$/,'')+(th.dataset.k===sortK?(sortDir>0?' ▲':' ▼'):'')});
}
function setManual(){if(mode!=='manual'){mode='manual';$('mode_manual').checked=true;$('topn').disabled=true;}save()}
function buildPanel(){
  $('drivers').innerHTML=D.drivers.map((d,i)=>`<div class="field"><label for="d${i}">${d.name}<small>uplift %</small></label><input id="d${i}" type="number" step="5" min="0" value="${Math.round(UP[i]*100)}"></div>`).join('');
  $('modules').innerHTML=modOrder.map((m,i)=>`<div class="field"><label for="m${i}">${m}<small>${D.rows.filter(r=>r.m===m).length} test cases</small></label><input id="m${i}" type="number" step="0.05" min="0" value="${MF[m].toFixed(2)}"></div>`).join('');
  D.drivers.forEach((d,i)=>$(`d${i}`).addEventListener('input',e=>{UP[i]=(+e.target.value||0)/100;render()}));
  modOrder.forEach((m,i)=>$(`m${i}`).addEventListener('input',e=>{MF[m]=+e.target.value||0;render()}));
  $('fmod').innerHTML+=modOrder.map(m=>`<option>${m}</option>`).join('');
  const dopts=D.drivers.map((d,i)=>`<option value="${i}">${d.name}</option>`).join('');$('fdrv').innerHTML+=dopts;$('fdrvx').innerHTML+=dopts;
}
function syncInputs(){for(const k in P){$(k).value=P[k];if($(k+'_r'))$(k+'_r').value=P[k]}}
for(const k in DEF){
  $(k).addEventListener('input',e=>{P[k]=+e.target.value||0;if(k==='team'&&P[k]<1)P[k]=1;if($(k+'_r'))$(k+'_r').value=P[k];render()});
  if($(k+'_r'))$(k+'_r').addEventListener('input',e=>{P[k]=+e.target.value;$(k).value=P[k];render()});
}
$('reset').addEventListener('click',()=>{P={...DEF};UP=D.drivers.map(d=>d.uplift);MF={...D.modfactor};syncInputs();D.drivers.forEach((d,i)=>$(`d${i}`).value=Math.round(UP[i]*100));modOrder.forEach((m,i)=>$(`m${i}`).value=MF[m].toFixed(2));render()});
['q','fmod','frec','fsize','fdrv','fdrvx','fsel'].forEach(id=>$(id).addEventListener('input',()=>{shown=100;renderTable(calc())}));
$('more').addEventListener('click',()=>{shown+=100;renderTable(calc())});
document.querySelectorAll('th[data-k]').forEach(th=>th.addEventListener('click',()=>{const k=th.dataset.k;if(sortK===k)sortDir=-sortDir;else{sortK=k;sortDir=typeof calc()[0][k]==='number'?-1:1}renderTable(calc())}));
$('bars').addEventListener('click',e=>{const m=e.target.dataset?.m;if(!m)return;$('fmod').value=$('fmod').value===m?'':m;shown=100;renderTable(calc());$('tbl').scrollIntoView({behavior:'smooth',block:'start'})});
document.querySelectorAll('input[name=mode]').forEach(r=>r.addEventListener('change',()=>{mode=r.value;applyMode();render()}));
$('topn').addEventListener('input',()=>{if(mode==='topn'){applyMode();render()}});
$('tbody').addEventListener('change',e=>{const n=+e.target.dataset?.n;if(!n)return;setManual();e.target.checked?sel.add(n):sel.delete(n);render()});
$('chkall').addEventListener('change',e=>{setManual();lastShown.forEach(r=>{if(r.st==='Duplicate')return;e.target.checked?sel.add(r.n):sel.delete(r.n)});render()});
$('selshown').addEventListener('click',()=>{setManual();lastShown.forEach(r=>{if(r.st!=='Duplicate')sel.add(r.n)});render()});
$('deselshown').addEventListener('click',()=>{setManual();lastShown.forEach(r=>sel.delete(r.n));render()});
$('selnone').addEventListener('click',()=>{setManual();sel.clear();render()});
function toast(msg){const t=document.createElement('div');t.className='toast';t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),3500)}
function buildWorkbook(){
  const rows=calc(),S=rows.filter(r=>r.on);
  const wb=XLSX.utils.book_new();
  const script=S.reduce((a,r)=>a+r.script,0),sub=S.reduce((a,r)=>a+r.total,0),grand=sub+P.fw;
  const sum=[['TMG NexGen – Playwright Automation Estimate (selected scope)'],['Exported',new Date().toLocaleString()],['Selection mode',mode==='topn'?`Top ${$('topn').value} by priority score`:mode==='rec'?'Recommended (Wave 1 + Wave 2)':'Manual selection'],[],
   ['Selected test cases',S.length],['Total steps',S.reduce((a,r)=>a+r.s,0)],[],['Scripting hrs',+script.toFixed(1)],['Test data prep hrs',+(script*P.data/100).toFixed(1)],['Review & stabilisation hrs',+(script*P.review/100).toFixed(1)],['Contingency hrs',+(script*P.cont/100).toFixed(1)],['Subtotal hrs',+sub.toFixed(1)],['Framework setup hrs',P.fw],['GRAND TOTAL hrs',+grand.toFixed(1)],[],
   ['Person-days',+(grand/6.5).toFixed(1)],['Person-months',+(grand/6.5/21).toFixed(1)],['Cost ($)',Math.round(grand*P.rate)],[`Duration with ${P.team} engineers (months)`,+(grand/6.5/21/P.team).toFixed(1)],[],
   ['By module','Cases','Total hrs','Cost ($)']];
  const agg={};S.forEach(r=>{(agg[r.m]??={h:0,c:0,$:0}).h+=r.total;agg[r.m].c++;agg[r.m].$+=r.cost});
  Object.keys(agg).sort((a,b)=>agg[b].h-agg[a].h).forEach(m=>sum.push([m,agg[m].c,+agg[m].h.toFixed(1),Math.round(agg[m].$)]));
  const ws1=XLSX.utils.aoa_to_sheet(sum);ws1['!cols']=[{wch:44},{wch:14},{wch:12},{wch:12}];XLSX.utils.book_append_sheet(wb,ws1,'Summary');
  const hdr=['#','TC ID','PBI','Title','Module','Status','Canonical #','Recommendation','Priority score','Steps',...D.drivers.map(d=>d.name),'Module factor','Uplift','Scope factor','Scripting hrs','Size','Data prep hrs','Review hrs','Contingency hrs','Total hrs','Cost ($)','Why'];
  const body=S.map(r=>[r.n,r.tc,r.pbi,r.t,r.m,r.st,r.canon||'',r.rec,r.sc,r.s,...r.f.map(f=>f?'Y':'N'),r.mf,r.up,r.factor,+r.script.toFixed(2),r.size,+(r.script*P.data/100).toFixed(2),+(r.script*P.review/100).toFixed(2),+(r.script*P.cont/100).toFixed(2),+r.total.toFixed(2),Math.round(r.cost),r.why]);
  const nD=D.drivers.length,c=i=>XLSX.utils.encode_col(i),last=body.length+1;
  const tot=['','','','TOTAL','','','','','',{f:`SUM(J2:J${last})`},...Array(nD).fill(''),'','','',{f:`SUM(${c(13+nD)}2:${c(13+nD)}${last})`},'',{f:`SUM(${c(15+nD)}2:${c(15+nD)}${last})`},{f:`SUM(${c(16+nD)}2:${c(16+nD)}${last})`},{f:`SUM(${c(17+nD)}2:${c(17+nD)}${last})`},{f:`SUM(${c(18+nD)}2:${c(18+nD)}${last})`},{f:`SUM(${c(19+nD)}2:${c(19+nD)}${last})`},''];
  const ws2=XLSX.utils.aoa_to_sheet([hdr,...body,tot]);ws2['!cols']=hdr.map((h,i)=>({wch:i===3?60:i===hdr.length-1?70:i===4?26:12}));ws2['!autofilter']={ref:`A1:${c(hdr.length-1)}${last}`};
  XLSX.utils.book_append_sheet(wb,ws2,'Selected Test Cases');
  const ex=rows.filter(r=>!r.on).map(r=>[r.n,r.tc,r.pbi,r.t,r.m,r.st,r.canon||'',r.rec,r.sc,r.s,+r.total.toFixed(2),r.why]);
  const ws3=XLSX.utils.aoa_to_sheet([['#','TC ID','PBI','Title','Module','Status','Canonical #','Recommendation','Priority score','Steps','Total hrs (if automated)','Why'],...ex]);ws3['!cols']=[{wch:5},{wch:8},{wch:10},{wch:60},{wch:26},{wch:12},{wch:10},{wch:20},{wch:8},{wch:6},{wch:12},{wch:70}];
  XLSX.utils.book_append_sheet(wb,ws3,'Not Selected');
  const asm=[['Assumption','Value'],['Base hours per test case',P.base],['Hours per step',P.step],['Uplift cap',P.cap/100],['Test data prep %',P.data/100],['Review & stabilisation %',P.review/100],['Contingency %',P.cont/100],['Data-variant parameterisation %',P.var/100],['Framework setup (hrs)',P.fw],['Hourly rate ($)',P.rate],['Team size',P.team],[],['Complexity driver','Uplift'],...D.drivers.map((d,i)=>[d.name,UP[i]]),[],['Module','Factor'],...modOrder.map(m=>[m,MF[m]]),[],['Formula','Scripting = CEILING((base + steps x hrs/step) x module factor x (1 + MIN(sum of uplifts, cap)), 0.5) x scope factor; Total = Scripting x (1 + data% + review% + contingency%)']];
  const ws4=XLSX.utils.aoa_to_sheet(asm);ws4['!cols']=[{wch:40},{wch:12}];XLSX.utils.book_append_sheet(wb,ws4,'Assumptions');
  return wb;
}
$('export').addEventListener('click',async()=>{
  const btn=$('export');btn.disabled=true;btn.textContent='Preparing…';
  try{
    if(typeof XLSX==='undefined')throw new Error('spreadsheet library did not load');
    const wb=buildWorkbook();const n=calc().filter(r=>r.on).length;
    const filename=`NexGen_Automation_Estimate_${n}_cases.xlsx`;
    const buf=XLSX.write(wb,{bookType:'xlsx',type:'array'});
    const blob=new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    const dl=window.claude?.use?await window.claude.use('downloads'):null;
    if(dl){try{await dl.save({filename,data:blob});toast(`Saved ${filename}`)}catch(e){if(e?.code!=='cancelled'&&e?.code!=='declined')toast('Export was not saved: '+(e?.message||e?.code||'declined'))}}
    else{const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},2000);toast(`Downloading ${filename}`)}
  }catch(e){toast('Export failed: '+(e?.message||e))}
  btn.disabled=false;btn.textContent='Export selection to Excel';
});
buildPanel();syncInputs();
try{const st=JSON.parse(localStorage.getItem('nexgen-sel')||'null');if(st&&st.mode){mode=st.mode;$('mode_'+mode).checked=true;if(st.n)$('topn').value=st.n;if(mode==='manual')sel=new Set(st.sel||[]);}}catch(e){}
applyMode();render();
</script>
